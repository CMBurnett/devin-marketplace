{
  "name": "chronosphere",
  "displayName": "Chronosphere",
  "description": "Query metrics, logs, traces, and events from Chronosphere (a Palo Alto Networks company) via its hosted MCP server.",
  "homepage": "https://chronosphere.io/",
  "logo": "https://www.google.com/s2/favicons?domain=chronosphere.io&sz=128",
  "keywords": [
    "Monitoring & Analytics"
  ],
  "mcpServers": {
    "chronosphere": {
      "url": "https://${CHRONOSPHERE_ORG_NAME}.chronosphere.io/api/mcp/mcp",
      "headers": {
        "Authorization": "Bearer ${CHRONOSPHERE_API_TOKEN}"
      }
    }
  }
}
